{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "${workspaceFolder}/examples/basic"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.cjs"],
      "preLaunchTask": "bundle the extension"
    }
  ]
}
