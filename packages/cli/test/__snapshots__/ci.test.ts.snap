            stateward-\${{ runner.os }}-1.2.3-\${{ hashFiles('yarn.lock') }}-
      - run: npx --no stateward check --format github
      - uses: actions/cache/save@v4
        if: always()
        with:
          path: node_modules/.cache/stateward
          key: stateward-\${{ runner.os }}-1.2.3-\${{ hashFiles('yarn.lock') }}-\${{ hashFiles('stateward.config.*') }}-\${{ github.sha }}
