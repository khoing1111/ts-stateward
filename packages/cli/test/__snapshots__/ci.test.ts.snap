"# Written by \`stateward init --ci github\`.
#
# The install step needs stateward and its packs in your project's devDependencies
# (\`npm install --save-dev stateward\`, and the packs \`init\` named).
name: stateward

on:
  pull_request:
  push:
    branches: [main]

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: yarn
      - run: yarn install --frozen-lockfile
      # Stateward re-checks only the files that changed since the last run. The cache is saved
      # under a new key each run (the commit), and the newest earlier one is restored.
      - uses: actions/cache/restore@v4
        with:
          path: node_modules/.cache/stateward
          key: stateward-\${{ runner.os }}-1.2.3-\${{ hashFiles('yarn.lock') }}-\${{ hashFiles('stateward.config.*') }}-\${{ github.sha }}
          restore-keys: |
            stateward-\${{ runner.os }}-1.2.3-\${{ hashFiles('yarn.lock') }}-\${{ hashFiles('stateward.config.*') }}-
            stateward-\${{ runner.os }}-1.2.3-\${{ hashFiles('yarn.lock') }}-
      - run: npx --no stateward check --format github
      - uses: actions/cache/save@v4
        if: always()
        with:
          path: node_modules/.cache/stateward
          key: stateward-\${{ runner.os }}-1.2.3-\${{ hashFiles('yarn.lock') }}-\${{ hashFiles('stateward.config.*') }}-\${{ github.sha }}
