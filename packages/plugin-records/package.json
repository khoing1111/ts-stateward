{
  "name": "@stateward/plugin-records",
  "version": "1.1.0",
  "description": "stateward rules for records: lookup tables and records keyed by a union have every key, once, under a type that names them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoing1111/ts-stateward.git",
    "directory": "packages/plugin-records"
  },
  "homepage": "https://github.com/khoing1111/ts-stateward/tree/main/packages/plugin-records#readme",
  "bugs": {
    "url": "https://github.com/khoing1111/ts-stateward/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@stateward/core": "workspace:*"
